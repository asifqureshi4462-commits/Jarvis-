<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_bg"
    android:fitsSystemWindows="true">

    <!-- Top Branding & Status Header Bar -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/jarvis_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App Logo (Ready for user custom logo) -->
        <ImageView
            android:id="@+id/ivAppLogo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/jarvis_text_primary" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textColor="@color/jarvis_accent" />
        </LinearLayout>

        <!-- System Active Pill -->
        <TextView
            android:id="@+id/tvSystemPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PURE JAVA 17"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textColor="@color/jarvis_accent"
            android:background="@drawable/bg_pill_accent"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Central Arc Reactor HUD Panel -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvArcReactor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/jarvis_surface"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <!-- Arc Reactor Circular Visualizer -->
            <FrameLayout
                android:id="@+id/flArcReactor"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_arc_reactor"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivReactorCore"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_launcher_foreground"
                    android:contentDescription="Reactor Core" />
            </FrameLayout>

            <!-- Status readout -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/status_system_ready"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="@color/jarvis_accent"
                android:gravity="center" />

            <!-- Real-Time Hardware Telemetry Strip (Real Device Sensors) -->
            <LinearLayout
                android:id="@+id/llLiveTelemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_surface_card"
                android:gravity="center">

                <!-- Battery Real-time -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvLiveBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="@color/jarvis_emerald" />
                    <TextView
                        android:id="@+id/tvLiveBatteryStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BATTERY"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/jarvis_text_muted" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="@color/jarvis_border" />

                <!-- RAM Real-time -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvLiveRam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- / -- GB"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="@color/jarvis_accent" />
                    <TextView
                        android:id="@+id/tvLiveRamPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RAM OCCUPIED"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/jarvis_text_muted" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="@color/jarvis_border" />

                <!-- CPU Cores & Model -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvLiveCpu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8 CORES"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="@color/jarvis_gold" />
                    <TextView
                        android:id="@+id/tvLiveNetwork"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ONLINE"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/jarvis_text_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Quick Action Chips Bar -->
    <HorizontalScrollView
        android:id="@+id/hsvQuickActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/cvArcReactor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipStatus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="System Status"
                android:textSize="11sp"
                android:textColor="@color/jarvis_accent"
                app:strokeColor="@color/jarvis_border_bright" />

            <Button
                android:id="@+id/chipNotes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="Notes Vault"
                android:textSize="11sp"
                android:textColor="@color/jarvis_accent"
                app:strokeColor="@color/jarvis_border_bright" />

            <Button
                android:id="@+id/chipMemory"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="Memory Bank"
                android:textSize="11sp"
                android:textColor="@color/jarvis_accent"
                app:strokeColor="@color/jarvis_border_bright" />

            <Button
                android:id="@+id/chipCalc"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Calculator"
                android:textSize="11sp"
                android:textColor="@color/jarvis_accent"
                app:strokeColor="@color/jarvis_border_bright" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat & Command History RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/hsvQuickActions"
        app:layout_constraintBottom_toTopOf="@id/llBottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Input & Microphone Bar -->
    <LinearLayout
        android:id="@+id/llBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:background="@color/jarvis_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Voice Activation Microphone Button -->
        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/btn_mic" />

        <!-- Command EditText Field -->
        <EditText
            android:id="@+id/etCommand"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/command_hint"
            android:textColorHint="@color/jarvis_text_muted"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="13sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="textCapSentences"
            android:imeOptions="actionSend" />

        <!-- Send Command Button -->
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_accent"
            android:src="@drawable/ic_send"
            android:contentDescription="@string/btn_send" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
