<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Jarvis" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/jarvis_accent</item>
        <item name="colorPrimaryVariant">@color/jarvis_surface_elevated</item>
        <item name="colorOnPrimary">@color/jarvis_bg</item>
        
        <!-- Secondary / Accent -->
        <item name="colorSecondary">@color/jarvis_gold</item>
        <item name="colorSecondaryVariant">@color/jarvis_emerald</item>
        <item name="colorOnSecondary">@color/jarvis_bg</item>
        
        <!-- Background and Surface Colors -->
        <item name="android:windowBackground">@color/jarvis_bg</item>
        <item name="colorSurface">@color/jarvis_surface</item>
        <item name="colorOnSurface">@color/jarvis_text_primary</item>
        
        <!-- System Windows & Navigation -->
        <item name="android:statusBarColor">@color/jarvis_bg</item>
        <item name="android:navigationBarColor">@color/jarvis_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
